# Copy this file to .env and fill in the values. Do not commit .env.

# Bot User OAuth Token, from OAuth & Permissions (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-...

# App-Level Token, from Basic Information / Socket Mode (starts with xapp-)
SLACK_APP_TOKEN=xapp-...

# Channel the bot posts "needs a task" reports to. Either a channel ID
# (e.g. C0123ABCD) or a public channel name like #team-tasks works.
# A private channel must be referenced by ID and have the bot invited.
WORKBOT_REPORT_CHANNEL=#team-tasks

# Default minutes between check-ins (can be left as is).
WORKBOT_DEFAULT_INTERVAL_MINUTES=60

# Languages offered in the Settings dropdown (comma-separated), and the
# fallback language. A file data/strings/<lang>.json is generated per language.
WORKBOT_LANGS=en,sv
WORKBOT_DEFAULT_LANG=en

# Status emojis that mean "out of office" - the bot never contacts or mentions
# a user whose Slack status uses one of these. Comma-separated.
WORKBOT_SKIP_STATUS_EMOJIS=:palm_tree:,:face_with_thermometer:

# Consecutive ignored check-ins before the bot pauses a user until tomorrow.
WORKBOT_IGNORE_THRESHOLD=3

# Minimum seconds between two accepted "free" DMs from the same user. Repeated
# "free" messages within this window are ignored, to prevent self-spam.
WORKBOT_FREE_COOLDOWN_SECONDS=120

# Jira (optional) - powers the per-user project multi-select in Settings. Uses
# Basic auth: the email plus an API token from id.atlassian.com. Leave empty to
# disable the Jira features.
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=your-atlassian-api-token

# Task suggestions (optional, default OFF): when a user answers No, reply in the
# report thread with a few role-matched unassigned Jira tasks. Needs the JIRA_*
# vars above and the Codex CLI in the container (see Dockerfile).
WORKBOT_SUGGEST_ENABLED=0
# Org-wide unassigned tasks to cache (refreshed hourly, so this can be large).
WORKBOT_SUGGEST_CACHE_MAX=2000
# Which Jira statuses count as candidate-eligible. Leave both empty for the
# default `statusCategory = "To Do"` (robust across projects, never suggests
# Done/In-Progress tickets). To pin exact statuses, set an allowlist (replaces
# the default); to prune specific ones, set a denylist (always subtracted).
# Comma-separated, names as they appear in Jira (spaces fine, no quotes needed).
#   WORKBOT_CANDIDATE_STATUSES=To Do,Open,Backlog
#   WORKBOT_CANDIDATE_EXCLUDE_STATUSES=Blocked,On hold
WORKBOT_CANDIDATE_STATUSES=
WORKBOT_CANDIDATE_EXCLUDE_STATUSES=
# Jira project keys to leave out entirely (comma-separated): never suggested,
# and not shown in the Settings project picker.
#   WORKBOT_EXCLUDE_PROJECTS=TPTU,OLD
WORKBOT_EXCLUDE_PROJECTS=
# Max candidates sent to the model per suggestion, and its timeout in seconds.
WORKBOT_SUGGEST_INPUT_MAX=200
WORKBOT_SUGGEST_TIMEOUT=90
# Variety: tasks offered to a user in the last N days are skipped on their next
# No (0 to turn off). Tasks with a priority in the KEEP list are still offered.
WORKBOT_SUGGEST_REPEAT_DAYS=3
WORKBOT_SUGGEST_REPEAT_KEEP=Highest,High
# The bot replies in a report thread only when a message addresses it (@WorkBot
# ...), using the thread as context (anyone may chat; replies are uncapped).
# These set how much of the thread is fed back to the model: the last N messages,
# trimmed to this many characters. Image/gif and text-less messages are ignored.
WORKBOT_SUGGEST_CONTEXT_MSGS=12
WORKBOT_SUGGEST_CONTEXT_CHARS=2000

# Assignment watch (optional, default OFF): after a user answers No, poll Jira
# and, once they get assigned a task, reply in that report thread ("@user was
# assigned KEY ..."). Needs the JIRA_* vars and the per-user Jira accountIds
# cached by `python -m workbot.map_jira` (which needs the users:read.email scope).
# Only the user's most recent open thread is watched. POLL_SECONDS is how often
# to check; SUMMARY_MAX trims the issue title in the message.
WORKBOT_ASSIGN_WATCH_ENABLED=0
WORKBOT_ASSIGN_POLL_SECONDS=300
WORKBOT_ASSIGN_SUMMARY_MAX=80

# Delete the bot's own DM messages older than this many hours, to keep each
# user's DM tidy. Set to 0 to disable pruning.
WORKBOT_PRUNE_AFTER_HOURS=24

# Emoji the bot pre-seeds as reactions on each report (comma-separated names,
# no colons) so people can one-click to acknowledge. Empty to add none.
WORKBOT_REPORT_REACTIONS=white_check_mark,eyes

# Optional: a Slack user-group handle to ping on every report, e.g. your
# project managers. Enter the handle WITHOUT the @ (e.g. projectmanagers).
# The bot resolves it to a subteam ID and caches that in the database, so you
# can change this handle and it re-resolves on the next restart. Requires the
# 'usergroups:read' bot scope (add it in the app config, then reinstall).
# Leave empty for no prefix. With it set, the report reads like:
#   <group> [waving hand] <user> needs a task!
# (the waving-hand emoji comes from the editable "report_prefix" string.)
WORKBOT_REPORT_GROUP=
